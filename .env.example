# Public Clerk key for the dashboard. Use the same Clerk app as the API.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Public API origin only (no trailing slash and no /api suffix).
VITE_API_BASE_URL=https://your-api.example.com

# Optional; leave blank unless your Clerk setup requires a proxy.
VITE_CLERK_PROXY_URL=
